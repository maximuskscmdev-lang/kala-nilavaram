# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Encryption key for whistleblower contact details (32-byte, base64).
# Generate with: openssl rand -base64 32
WHISTLEBLOWER_ENCRYPTION_KEY=

# News aggregation
NEWSDATA_API_KEY=
CRON_SECRET=change-me-to-a-random-string   # protects /api/cron/* endpoints

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Kala Nilavaram"

# Sign-in is Google OAuth + email OTP (magic link). No phone/SMS provider is
# required — the old phone-OTP flow was dropped in favor of email.

# Demo mode: when 'true', the app may use bundled mock Supabase credentials
# and fallback demo school chapters (DEMO_TENANTS) during local development.
# Mock fallbacks are NEVER used in production — missing variables throw instead.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Google Sign-In (Supabase Auth provider, configured in dashboard too).
# Used by supabase/config.toml for LOCAL dev; in production the dashboard
# provider settings are authoritative and these are not read by the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
